{
  "name": "nx-ng-net-core",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -n api,web,counter -c blue,green,yellow \"dotnet run --project apps/api/Api --launch-profile Api\" \"vp dev\" \"vp dev apps/counter-remote\"",
    "build:prod": "vp build",
    "build:dotnet-builder": "rimraf ./tools/builders/dotnet-builder/dist && tsc -p ./tools/builders/dotnet-builder",
    "clean": "rimraf ./dist ./junit ./coverage ./.angular",
    "clean:node_modules": "rimraf ./node_modules ./package-lock.json",
    "serve:api": "dotnet run --project apps/api/Api --launch-profile Api",
    "test:all": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "e2e": "playwright test --config=apps/web-app-e2e/playwright.config.ts",
    "e2e:ci": "pnpm e2e",
    "e2e:watch": "pnpm e2e --ui",
    "dotnet:restore": "dotnet restore apps/api",
    "dotnet:coverage": "dotnet tool install --global dotnet-coverage",
    "dotnet:outdated": "dotnet tool install --global dotnet-outdated-tool",
    "dotnet:clean": "dotnet clean apps/api",
    "dotnet:build": "dotnet build apps/api",
    "dotnet:update": "dotnet outdated -u apps/api",
    "preinstall": "pnpm dotnet:restore",
    "postinstall": "pnpm build:dotnet-builder",
    "prepare": "husky",
    "update-packages": "bun run ./tools/update-packages/src/main.tsx",
    "build:preview": "PREVIEW=true vp build"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "2.6.0",
    "@analogjs/router": "2.6.0",
    "@analogjs/vite-plugin-angular": "2.6.0",
    "@analogjs/vitest-angular": "2.6.0",
    "@angular/animations": "22.0.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/platform-server": "22.0.0",
    "@angular/router": "22.0.0",
    "@angular/service-worker": "22.0.0",
    "@ngrx/operators": "21.1.0",
    "@ngrx/signals": "21.1.0",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "front-matter": "^4.0.2",
    "marked": "18.0.5",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.2.1",
    "mermaid": "11.15.0",
    "ngx-markdown": "21.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/platform": "2.6.0",
    "@angular-devkit/architect": "0.2200.0",
    "@angular-devkit/core": "22.0.0",
    "@angular-devkit/schematics": "22.0.0",
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/language-service": "22.0.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@module-federation/vite": "1.16.4",
    "@oxc-project/runtime": "0.134.0",
    "@playwright/test": "1.60.0",
    "@schematics/angular": "22.0.0",
    "@testing-library/angular": "19.4.1",
    "@testing-library/dom": "10.4.1",
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "autoprefixer": "10.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "postcss": "8.5.15",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vite-plus": "^0.1.20",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.0.9"
}
