{
  "name": "counter-remote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/counter-remote/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "command": "vite build",
      "cache": true,
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/counter-remote"],
      "options": {
        "cwd": ".",
        "config": "apps/counter-remote/vite.config.mts"
      },
      "configurations": {
        "development": {
          "args": ["--mode", "development"]
        },
        "production": {
          "args": ["--mode", "production"]
        }
      }
    },
    "serve": {
      "command": "vite",
      "continuous": true,
      "defaultConfiguration": "development",
      "options": {
        "cwd": ".",
        "config": "apps/counter-remote/vite.config.mts"
      },
      "configurations": {
        "development": {
          "args": ["--mode", "development"]
        },
        "production": {
          "args": ["--mode", "production"]
        }
      }
    },
    "test": {
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/counter-remote"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.cjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
